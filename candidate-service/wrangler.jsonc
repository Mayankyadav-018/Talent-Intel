{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candidate-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",

  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
	"GEMINI_API_KEY": "",
